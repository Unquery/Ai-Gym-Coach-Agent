# Copy to .env and replace all placeholders locally. Never commit .env.
# Keep Unicode smoke-test output intact when Python stdout is piped on Windows.
PYTHONIOENCODING=utf-8
# Local demo mode only. Never enable demo identity on a public server.
APP_ENV=development
ENABLE_DEMO_AUTH=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Empty by default; comma-separated exact origins, no trailing slash.
CORS_ORIGINS=
# Production: APP_ENV=production, ENABLE_DEMO_AUTH=false, explicit public host,
# HTTPS CORS origins, a random non-demo owner UUID and a random bearer token.
# API_AUTH_TOKEN=<generate at least 32 random characters; store as a secret>
# API_OWNER_ID=<generate a UUID; never use the synthetic demo owner>
# Production DATABASE_URL requires sslmode=verify-full and a trusted CA bundle.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
MAX_REQUEST_BYTES=16384
CHAT_REQUESTS_PER_MINUTE=10
API_REQUESTS_PER_MINUTE=120
LOG_LEVEL=INFO
# Use distinct random passwords; URL-encode the app password in database URLs.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
APP_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_APP_PASSWORD
DATABASE_URL=postgresql+psycopg://gym_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@127.0.0.1:5432/gym_coach
# Same local database from the optional Compose backend profile.
CONTAINER_DATABASE_URL=postgresql+psycopg://gym_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@db:5432/gym_coach
# Local DDL owner only. In production use a separate migration role/direct URL.
MIGRATION_DATABASE_URL=postgresql+psycopg://gym_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@127.0.0.1:5432/gym_coach
CONTAINER_MIGRATION_DATABASE_URL=postgresql+psycopg://gym_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@db:5432/gym_coach
# Tests create and remove uniquely named schemas, never application tables.
TEST_DATABASE_URL=postgresql+psycopg://gym_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@127.0.0.1:5432/gym_coach

# GroqCloud through the official OpenAI SDK; model and key are required.
# LLM_BASE_URL defaults to the Groq URL below when omitted.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
# For local Ollama, replace the three settings above (do not duplicate them):
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_MODEL=gpt-oss:20b
# LLM_API_KEY=ollama
# Use an installed local model; the local server ignores the dummy key.
