# Copy to ignored .local/runtime.env; never store real credentials here.
APP_ENV=production
ENABLE_DEMO_AUTH=false
DATABASE_URL=postgresql+psycopg://gym_runtime:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_NEON_DIRECT_HOST/neondb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt&channel_binding=require
API_AUTH_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
API_OWNER_ID=REPLACE_WITH_FRESH_NON_DEMO_UUID
ALLOWED_HOSTS=REPLACE_WITH_SERVICE_NAME.onrender.com,localhost,127.0.0.1
CORS_ORIGINS=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=REPLACE_WITH_PROVIDER_KEY
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
MAX_REQUEST_BYTES=16384
CHAT_REQUESTS_PER_MINUTE=2
API_REQUESTS_PER_MINUTE=60
LOG_LEVEL=INFO
